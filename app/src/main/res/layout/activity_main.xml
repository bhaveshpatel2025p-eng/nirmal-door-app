<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="NIRMAL DOOR" android:textSize="25sp" android:textStyle="bold" android:textColor="#FFFFFF" android:background="#172033" android:padding="18dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Opp Railway Station, KUDACHI-591311 | 8050304196 | nirmaldoorkud@gmail.com" android:padding="10dp"/>
<EditText android:id="@+id/invoiceNo" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Invoice No."/>
<EditText android:id="@+id/customer" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Customer Name"/>
<EditText android:id="@+id/mobile" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Customer Mobile" android:inputType="phone"/>
<EditText android:id="@+id/address" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Customer Address"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DOOR ITEMS" android:textStyle="bold" android:textSize="18sp" android:paddingTop="14dp"/>
<LinearLayout android:id="@+id/itemsContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
<Button android:id="@+id/addDoor" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="+ ADD DOOR"/>
<EditText android:id="@+id/discount" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Discount ₹" android:inputType="numberDecimal"/>
<EditText android:id="@+id/gst" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="GST %" android:inputType="numberDecimal"/>
<EditText android:id="@+id/paid" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Advance / Paid ₹" android:inputType="numberDecimal"/>
<TextView android:id="@+id/summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Subtotal: ₹0.00" android:textSize="17sp" android:textStyle="bold" android:padding="12dp"/>
<Button android:id="@+id/save" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SAVE BILL"/>
<Button android:id="@+id/pdf" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="PDF / PRINT"/>
<Button android:id="@+id/whatsapp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="WHATSAPP BILL"/>
<Button android:id="@+id/newBill" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="NEW BILL"/>
</LinearLayout></ScrollView>
